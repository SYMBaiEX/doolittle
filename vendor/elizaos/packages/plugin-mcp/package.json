  "files": [
    "registry-entry.json",
    "dist"
  ],
  "keywords": [],
  "author": "elizaOS",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0",
    "@elizaos/host": "2.0.12-beta.0",
    "@elizaos/plugin-assistant": "2.0.12-beta.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "ajv": "^8.17.1",
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@elizaos/core": "2.0.12-beta.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "PATH": {
        "type": "string",
        "description": "System PATH inherited from the host environment and forwarded to child processes when launching an MCP server through stdio transport.",
        "required": false,
        "sensitive": false
      },
      "mcp": {
        "type": "string",
        "description": "Serialized (e.g., JSON) configuration that defines MCP settings and server definitions; read at runtime to establish MCP server connections.",
        "required": false,
        "sensitive": false
      }
    }
  },
  "eliza": {
    "platforms": [
      "node"
    ],
    "runtime": "node",
    "platformDetails": {
      "node": "Node.js ESM package root"
    }
  },
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-mcp",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
