{
  "name": "@elizaos/plugin-web-search",
  "version": "2.0.12-beta.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./*.css": "./dist/*.css",
    "./edge": {
      "eliza-source": "./src/edge.ts",
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./browser-web-search": {
      "eliza-source": "./src/browser-web-search.ts",
      "types": "./dist/browser-web-search.d.ts",
      "import": "./dist/browser-web-search.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:client:1.0.0",
    "pluginParameters": {
      "WEB_SEARCH_BROWSER_PROFILE_ID": {
        "type": "string",
        "description": "Explicit owner grant: exact registered Chromium profile ID permitted for browser-first web searches."
      },
      "WEB_SEARCH_BROWSER_TARGET_ID": {
        "type": "string",
        "description": "Registered profile-bound browser target; defaults to chromium-device. Does not grant access without the exact profile ID."
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-web-search",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
}
