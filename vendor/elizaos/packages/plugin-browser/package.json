{
  "name": "@elizaos/plugin-browser",
  "version": "2.0.12-beta.0",
  "type": "module",
  "description": "Browser automation through the embedded desktop workspace, JSDOM, and optional Stagehand targets.",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./remote-controller": {
      "browser": null,
      "eliza-source": "./src/remote-controller.ts",
      "types": "./dist/remote-controller.d.ts",
      "import": "./dist/remote-controller.js",
      "default": "./dist/remote-controller.js"
    },
    "./remote-control/browser-controller": {
      "browser": null,
      "eliza-source": "./src/remote-control/browser-controller.ts",
      "types": "./dist/remote-control/browser-controller.d.ts",
      "import": "./dist/remote-control/browser-controller.js",
      "default": "./dist/remote-control/browser-controller.js"
    },
    "./remote-control/controller": {
      "browser": null,
      "eliza-source": "./src/remote-control/controller.ts",
      "types": "./dist/remote-control/controller.d.ts",
      "import": "./dist/remote-control/controller.js",
      "default": "./dist/remote-control/controller.js"
    },
    "./remote-control/crypto": {
      "browser": null,
      "eliza-source": "./src/remote-control/crypto.ts",
      "types": "./dist/remote-control/crypto.d.ts",
      "import": "./dist/remote-control/crypto.js",
      "default": "./dist/remote-control/crypto.js"
    },
    "./remote-control/runtime-store": {
      "browser": null,
      "eliza-source": "./src/remote-control/runtime-store.ts",
      "types": "./dist/remote-control/runtime-store.d.ts",
      "import": "./dist/remote-control/runtime-store.js",
      "default": "./dist/remote-control/runtime-store.js"
    },
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@elizaos/auth": "2.0.12-beta.0",
    "@elizaos/core": "2.0.12-beta.0",
    "@elizaos/host": "2.0.12-beta.0",
    "@elizaos/plugin-assistant": "2.0.12-beta.0",
    "@elizaos/plugin-elizacloud": "2.0.12-beta.0",
    "drizzle-orm": "0.45.4",
    "linkify-it": "5.0.2",
    "@elizaos/contracts": "2.0.12-beta.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "elizaos": {
    "plugin": {
      "autoEnableModule": "./auto-enable.ts",
      "capabilities": [
        "browser-automation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "registry-entry.json",
    "dist",
    "auto-enable.ts"
  ],
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-browser",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
}
