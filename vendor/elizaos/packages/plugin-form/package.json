{
  "name": "@elizaos/plugin-form",
  "version": "2.0.5",
  "type": "module",
  "description": "Eliza plugin-form: conversational forms as guardrails for guided user journeys.",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@elizaos/core": "2.0.5",
    "@elizaos/host": "2.0.5",
    "@elizaos/plugin-assistant": "2.0.5",
    "uuid": "^14.0.0"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {},
    "description": "Conversational forms for structured data collection."
  },
  "elizaos": {
    "app": {
      "heroImage": "assets/hero.png"
    },
    "plugin": {
      "autoEnableModule": "./auto-enable.ts",
      "capabilities": [
        "forms"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "registry-entry.json",
    "dist",
    "auto-enable.ts"
  ],
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "c094a549fee09f6e06911b8486b9789b536401aa",
    "package": "plugins/plugin-form",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "c637bec3934c7a44e04ea5dfbca7ef167049a88a4387e9defef0bc67dc5ca221"
  }
}
