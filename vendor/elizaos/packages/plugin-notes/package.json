{
  "name": "@elizaos/plugin-notes",
  "version": "2.0.12-beta.0",
  "type": "module",
  "description": "Cloud Notes view with durable agent-driven CRUD.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./workspace": {
      "eliza-source": "./src/workspace.ts",
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "default": "./dist/workspace.js"
    },
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./register": {
      "eliza-source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./client": {
      "eliza-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client/*": {
      "eliza-source": "./src/client/*.ts",
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js",
      "default": "./dist/client/*.js"
    }
  },
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0",
    "@elizaos/host": "2.0.12-beta.0",
    "@elizaos/plugin-assistant": "2.0.12-beta.0",
    "@elizaos/ui": "2.0.12-beta.0",
    "lucide-react": "^1.0.0",
    "react": "^19.3.1",
    "@elizaos/contracts": "2.0.12-beta.0"
  },
  "peerDependencies": {
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "elizaos": {
    "appRegister": {
      "export": "registerNotesApp",
      "subpath": "register"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-notes",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
}
