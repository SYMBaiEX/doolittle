{
  "name": "@elizaos/plugin-todos",
  "version": "2.0.12-beta.0",
  "description": "User-scoped persistent todos with CRUD. Single TODO umbrella action (op-based: write/create/update/complete/cancel/delete/list/clear) and a currentTodosProvider that surfaces the user's pending + in-progress todos to the planner each turn. Backed by drizzle pgSchema('todos').",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos/eliza.git"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css"
  },
  "files": [
    "registry-entry.json",
    "assets",
    "dist"
  ],
  "keywords": [
    "eliza",
    "plugin",
    "todos",
    "todo",
    "tasks",
    "agent"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.0.0"
  },
  "peerDependencies": {
    "@elizaos/plugin-sql": "2.0.12-beta.0",
    "@elizaos/ui": "2.0.12-beta.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "elizaos": {
    "app": {
      "displayName": "Todos",
      "category": "productivity"
    }
  },
  "eliza": {
    "platforms": [
      "node",
      "edge"
    ],
    "runtime": "node",
    "platformDetails": {
      "node": "Root export with runtime-managed TodoStore",
      "edge": "Root createTodosEdgePlugin factory with injected durable TodoStore"
    }
  },
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-todos",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
}
