{
  "name": "@elizaos/plugin-maps",
  "version": "2.0.12-beta.0",
  "type": "module",
  "description": "Provider-neutral place search, routing, saved places, sharing, and navigation handoffs for Eliza agents.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "eliza-source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./ui": {
      "eliza-source": "./src/components/maps-view-bundle.ts",
      "types": "./dist/components/maps-view-bundle.d.ts",
      "import": "./dist/components/maps-view-bundle.js",
      "default": "./dist/components/maps-view-bundle.js"
    },
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./client": {
      "eliza-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client/*": {
      "eliza-source": "./src/client/*.ts",
      "types": "./dist/client/*.d.ts",
      "import": "./dist/client/*.js",
      "default": "./dist/client/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0",
    "@elizaos/ui": "2.0.12-beta.0",
    "lucide-react": "^1.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react-dom": "^19.0.0",
    "@capacitor/core": "^8.5.2",
    "maplibre-gl": "^6.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "elizaos": {
    "appRegister": {
      "subpath": "register",
      "export": "registerApp"
    },
    "app": {
      "displayName": "Maps",
      "category": "productivity"
    }
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "b2dbeff3ab689a69f7e518deb7d608d1c4607790",
    "package": "plugins/plugin-maps",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "61328582d89e162bc299241eba0f120ceaf7d7cdaff4ab043143d2f3b18ef2e0"
  }
}
