{
  "name": "@elizaos/plugin-native-filesystem",
  "version": "2.0.12-beta.0",
  "description": "Mobile-safe filesystem bridge for canonical FILE target=device operations on iOS/Android and desktop/AOSP.",
  "type": "module",
  "main": "dist/index.js",
