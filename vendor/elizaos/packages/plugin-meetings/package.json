{
  "name": "@elizaos/plugin-meetings",
  "version": "2.0.5",
  "description": "Meeting transcription plugin for elizaOS agents — browser bots that join Google Meet / Microsoft Teams / Zoom as guests, capture per-speaker audio, transcribe through the runtime model layer, and land diarized transcripts in the Transcripts view and knowledge store",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "auto-enable.ts",
    "NOTICE"
  ],
  "elizaos": {
    "plugin": {
      "autoEnableModule": "./auto-enable.ts",
      "capabilities": [
        "meeting-transcription"
      ]
    }
  },
  "dependencies": {
    "@elizaos/core": "2.0.5",
    "@elizaos/host": "2.0.5",
    "playwright-core": "^1.56.0"
  },
  "peerDependencies": {
    "@elizaos/core": "2.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "doolittleSourceBuild": {
    "repository": "https://github.com/elizaos/eliza",
    "commit": "c094a549fee09f6e06911b8486b9789b536401aa",
    "package": "plugins/plugin-meetings",
    "bun": "1.4.2",
    "node": "26.5.0",
    "nub": "0.9.7",
    "toolLockSha256": "c637bec3934c7a44e04ea5dfbca7ef167049a88a4387e9defef0bc67dc5ca221"
  }
}
