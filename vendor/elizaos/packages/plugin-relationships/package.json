  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "2.0.12-beta.0",
    "@elizaos/ui": "2.0.12-beta.0",
    "drizzle-orm": "0.45.4",
    "zod": "^4.6.5",
    "@elizaos/contracts": "2.0.12-beta.0"
  },
  "peerDependencies": {
    "@elizaos/plugin-sql": "2.0.12-beta.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "elizaos": {
