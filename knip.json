{
  "workspaces": {
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "src/controls.tsx",
        "src/surfaces.tsx",
        "src/host.ts",
        "src/themes.ts",
        "src/ag-ui.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/agent": {
      "ignoreDependencies": ["sharp"],
      "ignoreBinaries": ["const", "mkfifo"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["electron-builder"],
      "ignoreBinaries": [
        "ditto",
        "mkfifo",
        "osascript",
        "pgrep",
        "plutil",
        "wine"
      ],
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.tsx",
        "vite.*.config.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/plugins": {
      "project": ["doolittle-plugin/**/*.ts"]
    },
    "packages/plugins/plugin-sql": {
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["scriptc", "@elizaos/plugin-sql"]
    },
    "apps/cli": {
      "entry": ["src/index.ts", "src/acp-server.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
