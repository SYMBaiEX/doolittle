{
  "workspaces": {
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "src/controls.tsx",
        "src/surfaces.tsx",
        "src/host.ts",
        "src/themes.ts",
        "src/ag-ui.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/agent": {
      "ignoreBinaries": ["const"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["electron-builder"],
      "ignoreBinaries": ["ditto", "osascript", "pgrep", "plutil", "wine"]
    },
    "packages/plugins": {
      "project": ["doolittle-plugin/**/*.ts"]
    },
    "packages/plugins/plugin-sql": {
      "project": ["src/**/*.ts"]
    }
  }
}
