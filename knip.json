{
  "workspaces": {
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "src/controls.tsx",
        "src/surfaces.tsx",
        "src/host.ts",
        "src/themes.ts",
        "src/environment.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/agent": {
      "entry": ["src/native-tools/doolittle-probe.ts"],
      "ignoreDependencies": ["sharp"],
      "ignoreBinaries": ["const", "mkfifo"]
    },
    "apps/desktop": {
      "ignoreDependencies": ["electron-builder"],
      "ignoreBinaries": [
        "ditto",
        "mkfifo",
        "osascript",
        "pgrep",
        "plutil",
        "wine"
      ],
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/preload/extension-bridge.ts",
        "src/renderer/main.tsx",
        "vite.*.config.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/plugins": {
      "project": ["doolittle-plugin/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["scriptc", "@elizaos/plugin-sql"]
    },
    "apps/cli": {
      "entry": ["src/index.ts", "src/acp-server.ts", "src/managed-runtime.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "acpx",
        "@elizaos/agent",
        "@elizaos/auth",
        "@elizaos/logger",
        "@elizaos/plugin-agent-orchestrator",
        "@elizaos/plugin-agent-skills",
        "@elizaos/plugin-anthropic",
        "@elizaos/plugin-assistant",
        "@elizaos/plugin-browser",
        "@elizaos/plugin-codex-cli",
        "@elizaos/plugin-discord",
        "@elizaos/plugin-elizacloud",
        "@elizaos/plugin-form",
        "@elizaos/plugin-github",
        "@elizaos/plugin-mcp",
        "@elizaos/plugin-ollama",
        "@elizaos/plugin-openai",
        "@elizaos/plugin-pdf",
        "@elizaos/plugin-slack",
        "@elizaos/plugin-telegram",
        "@elizaos/shared",
        "@elizaos/skills"
      ]
    }
  },
  "ignoreWorkspaces": ["vendor/elizaos/packages/*"]
}
