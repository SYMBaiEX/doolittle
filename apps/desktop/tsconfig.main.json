{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "vite.*.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
