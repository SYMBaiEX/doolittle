{
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "vite.*.config.ts",
    "scripts/**/*.ts",
    "../../scripts/cli-build-options.ts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "extends": "../../tsconfig.base.json"
}
