{
  "name": "@doolittle/desktop",
  "version": "0.1.0",
  "description": "Native desktop application for the Doolittle ElizaOS agent runtime",
  "author": "SYMBaiEX",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "nub scripts/dev.ts",
    "build": "nub run build:main && nub run build:renderer",
    "build:main": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "runtime:prepare": "nub scripts/prepare-runtime.ts",
    "package": "nub run build && nub run runtime:prepare && nubx --node electron-builder",
    "package:dir": "nub run build && nub run runtime:prepare && nub scripts/package.ts --dir",
    "package:mac": "nub run build && nub run runtime:prepare && nubx --node electron-builder --mac dmg zip",
    "package:win": "nub run build && nub run runtime:prepare && nubx --node electron-builder --win nsis --x64",
    "package:linux": "nub run build && nub run runtime:prepare && nubx --node electron-builder --linux AppImage deb",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.renderer.json",
    "test": "nubx --node vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "electron-updater": "^6.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "ai.doolittle.desktop",
    "productName": "Doolittle",
    "executableName": "Doolittle",
    "artifactName": "Doolittle-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime/bin"
      },
      {
        "from": "../../package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "../../AGENTS.md",
        "to": "runtime/AGENTS.md"
      },
      {
        "from": "../../packages/skills",
        "to": "runtime/packages/skills",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      },
      {
        "from": "../../packages/skill-packs-optional",
        "to": "runtime/packages/skill-packs-optional",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      },
      {
        "from": "../../packages/characters",
        "to": "runtime/packages/characters",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Doolittle",
      "uninstallDisplayName": "Doolittle"
    }
  }
}
