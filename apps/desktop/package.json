{
  "name": "@doolittle/desktop",
  "version": "2.0.3-beta.7",
  "description": "Native desktop application for the Doolittle ElizaOS agent runtime",
  "author": "SYMBaiEX",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "nub scripts/dev.ts",
    "build": "nub run build:main && nub run build:renderer",
    "build:main": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts && nub scripts/renderer-bundle-budget.ts",
    "runtime:prepare": "nub scripts/prepare-runtime.ts",
    "package": "nub run build && nub run runtime:prepare && nubx electron-builder && nub scripts/verify-package.ts",
    "package:dir": "nub run build && nub run runtime:prepare && nub scripts/package.ts --dir && nub scripts/verify-package.ts",
    "package:mac": "nub run build && nub run runtime:prepare && nubx electron-builder --mac dmg zip && nub scripts/verify-package.ts",
    "package:win": "nub run build && nub run runtime:prepare && nubx electron-builder --win nsis --x64 && nub scripts/verify-package.ts",
    "package:linux": "nub run build && nub run runtime:prepare && nubx electron-builder --linux AppImage deb && nub scripts/verify-package.ts",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.renderer.json",
    "test": "nubx vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@doolittle/contracts": "workspace:*",
    "@electron/asar": "4.2.1",
    "@elizaos/agent": "2.0.3-beta.7",
    "@elizaos/logger": "2.0.3-beta.7",
    "@elizaos/shared": "2.0.3-beta.7",
    "@elizaos/ui": "2.0.3-beta.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.7",
    "esbuild": "0.28.2",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "ai.doolittle.desktop",
    "productName": "Doolittle",
    "executableName": "Doolittle",
    "artifactName": "Doolittle-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SYMBaiEX",
        "repo": "doolittle",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime/bin",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "build/runtime/node_modules",
        "to": "runtime/bin/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../package.json",
        "to": "runtime/package.json"
      },
      {
        "from": "../../AGENTS.md",
        "to": "runtime/AGENTS.md"
      },
      {
        "from": "../../packages/skills",
        "to": "runtime/packages/skills",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      },
      {
        "from": "../../packages/skill-packs-optional",
        "to": "runtime/packages/skill-packs-optional",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      },
      {
        "from": "../../packages/characters",
        "to": "runtime/packages/characters",
        "filter": [
          "**/*",
          "!**/dist/**",
          "!**/node_modules/**",
          "!**/*.test.ts"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Doolittle",
      "uninstallDisplayName": "Doolittle"
    }
  }
}
