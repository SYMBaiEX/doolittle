{
  "compilerOptions": {
    "composite": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "extends": "../../tsconfig.base.json"
}
