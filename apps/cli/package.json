{
  "name": "@doolittle/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doolittle terminal chat, fullscreen cockpit, commands and runtime process host.",
  "bin": {
    "doolittle": "./src/index.ts"
  },
  "scripts": {
    "dev": "nub watch src/index.ts",
    "start": "nub src/index.ts",
    "build": "nub ../../scripts/build-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@doolittle/agent": "workspace:*",
    "@doolittle/contracts": "workspace:*",
    "@elizaos/core": "workspace:2.0.12-beta.0",
