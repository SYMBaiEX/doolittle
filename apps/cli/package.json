    "@doolittle/acp": "workspace:*",
    "@elizaos/host": "workspace:2.0.12-beta.0",
    "acpx": "0.21.1",
    "@elizaos/agent": "workspace:2.0.12-beta.0",
    "@elizaos/logger": "2.0.11-beta.7",
    "@elizaos/plugin-agent-orchestrator": "workspace:2.0.12-beta.0",
    "@elizaos/plugin-agent-skills": "2.0.0-beta.1",
    "@elizaos/plugin-anthropic": "workspace:2.0.12-beta.0",
    "@elizaos/plugin-browser": "workspace:2.0.12-beta.0",
    "@elizaos/plugin-codex-cli": "2.0.3-beta.7",
