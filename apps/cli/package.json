    "@elizaos/plugin-telegram": "workspace:2.0.12-beta.0",
    "@elizaos/shared": "2.0.11-beta.7",
    "@elizaos/skills": "2.0.11-beta.7",
    "@elizaos/auth": "workspace:2.0.12-beta.0",
