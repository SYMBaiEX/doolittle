{
  "name": "@doolittle/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doolittle terminal chat, fullscreen cockpit, commands and runtime process host.",
  "bin": {
    "doolittle": "./src/index.ts"
  },
  "scripts": {
    "dev": "nub watch src/index.ts",
    "start": "nub src/index.ts",
    "build": "nub ../../scripts/build-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@doolittle/agent": "workspace:*",
    "@doolittle/contracts": "workspace:*",
    "@elizaos/core": "2.0.3-beta.7",
    "blessed": "^0.1.81",
    "@elizaos/agent": "2.0.3-beta.7",
    "@elizaos/shared": "2.0.11-beta.7",
    "@doolittle/acp": "workspace:*"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27"
  }
}
