{
  "name": "doolittle",
  "version": "0.1.0",
  "private": true,
  "elizaSdk": {
    "channel": "beta",
    "version": "2.0.3-beta.7"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "doolittle": "./packages/agent/src/index.ts"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Monorepo for the Nub-powered ElizaOS-native Doolittle platform and vendored official workspace packages.",
  "workspaces": [
    "apps/desktop",
    "packages/acp",
    "packages/agent",
    "packages/app-training",
    "packages/benchmarks",
    "packages/cloud-shared",
    "packages/contracts",
    "packages/plugin-remote-manifest",
    "packages/plugin-worker-runtime",
    "packages/registry",
    "packages/distributions",
    "packages/modeling",
    "packages/skill-packs-optional",
    "packages/plugins",
    "packages/plugins/*",
    "packages/skills",
    "packages/characters"
  ],
  "scripts": {
    "bootstrap": "nub scripts/bootstrap.ts",
    "bootstrap:check": "nub scripts/bootstrap.ts --check",
    "onboard": "nub scripts/bootstrap.ts",
    "smoke:linked-providers": "nub scripts/smoke-linked-providers.ts",
    "publish:providers": "nub scripts/publish-provider-packages.ts",
    "publish:providers:alpha": "nub run publish:providers -- --provider all --publish --tag alpha",
    "install:deps": "bash scripts/install.sh",
    "sandbox:setup": "bash scripts/sandbox-setup.sh",
    "test:sandbox:integration": "DOOLITTLE_RUN_SANDBOX_INTEGRATION=1 nubx --node vitest run packages/plugins/doolittle-plugin/local-sandbox/integration.test.ts",
    "dev": "nub run --cwd packages/agent dev",
    "start": "nub run --cwd packages/agent start",
    "build": "nub run --cwd packages/agent build",
    "desktop:dev": "nub run --cwd apps/desktop dev",
    "desktop:build": "nub run --cwd apps/desktop build",
    "desktop:typecheck": "nub run --cwd apps/desktop typecheck",
    "desktop:test": "nub run --cwd apps/desktop test",
    "desktop:runtime:install": "node node_modules/electron/install.js",
    "desktop:package": "nub run --cwd apps/desktop package",
    "desktop:package:dir": "nub run --cwd apps/desktop package:dir",
    "desktop:package:win": "nub run --cwd apps/desktop package:win",
    "lint": "nubx --node biome check --write .",
    "lint:check": "nubx --node biome check .",
    "knip:deps": "nubx -y --node knip@6.31.0 --config knip.json --dependencies --no-progress --no-config-hints --no-tag-hints --workspace packages/agent --workspace apps/desktop --workspace packages/plugins/provider-transport --workspace packages/plugins/plugin-claude-code --workspace packages/plugins/plugin-devin",
    "audit:production:critical": "nub audit --production --audit-level critical",
    "typecheck": "nubx --node tsc --noEmit",
    "test": "nubx --node vitest run",
    "test:coding-harness": "nubx --node vitest run scripts/acceptance/coding-loop-harness.test.ts",
    "test:research-harness": "nubx --node vitest run scripts/acceptance/research-orchestration-harness.test.ts",
    "test:account-pool": "nubx --node vitest run packages/agent/src/runtime/native/account-pool/index.test.ts packages/agent/src/server/routes/runtime/accounts.test.ts",
    "check:alpha": "nub run test:coding-harness && nub run test:research-harness && nub run test:account-pool",
    "test:e2e": "nub run desktop:build && nubx --node playwright test",
    "check:repo-hygiene": "nub scripts/check-repo-hygiene.ts",
    "check:workflow-security": "nub scripts/check-workflow-security.ts",
    "check:plugin-boundaries": "nub scripts/check-plugin-boundaries.ts",
    "check:eliza-sdk": "nub scripts/check-eliza-sdk-release.ts",
    "check:docs-truth": "nub scripts/sync-doc-truth.ts --check",
    "check:local-links": "nub scripts/check-local-links.ts",
    "check:acceptance": "nub run check:repo-hygiene && nub run check:workflow-security && nub run check:plugin-boundaries && nub run check:eliza-sdk && nub run check:docs-truth && nub run check:local-links && nub run knip:deps && nub run audit:production:critical",
    "check": "nub run lint:check && nub run typecheck && nub run desktop:typecheck && nub run test && nub run build",
    "publish:claude-code:dry-run": "nub run publish:providers -- --provider claude-code",
    "publish:devin:dry-run": "nub run publish:providers -- --provider devin",
    "publish:provider-transport:dry-run": "nub run publish:providers -- --provider provider-transport",
    "publish:providers:check": "nub run publish:providers -- --provider all",
    "workspace:list": "find packages -maxdepth 2 -mindepth 1 -type f -name package.json | sort",
    "workspace:plugins": "nub run --cwd packages/agent start --help"
  },
  "dependencies": {
    "@doolittle/acp": "workspace:*",
    "@doolittle/contracts": "workspace:*",
    "@electric-sql/pglite": "0.4.5",
    "@elizaos/agent": "2.0.3-beta.7",
    "@elizaos/app-core": "2.0.3-beta.7",
    "@elizaos/app-training": "workspace:*",
    "@elizaos/cloud-shared": "workspace:*",
    "@elizaos/core": "2.0.3-beta.7",
    "@elizaos/logger": "2.0.3-beta.7",
    "@elizaos/plugin-agent-orchestrator": "2.0.3-beta.7",
    "@elizaos/plugin-agent-skills": "2.0.3-beta.7",
    "@elizaos/plugin-codex-cli": "2.0.3-beta.7",
    "@elizaos/plugin-mcp": "2.0.3-beta.7",
    "@elizaos/plugin-anthropic": "2.0.3-beta.7",
    "@elizaos/plugin-browser": "2.0.3-beta.7",
    "@elizaos/plugin-form": "2.0.3-beta.7",
    "@elizaos/plugin-github": "2.0.3-beta.7",
    "@doolittle/plugin-claude-code": "workspace:*",
    "@doolittle/plugin-devin": "workspace:*",
    "@doolittle/plugin-sql-compat": "workspace:*",
    "@elizaos/plugin-elizacloud": "2.0.3-beta.7",
    "@elizaos/plugin-ollama": "2.0.3-beta.7",
    "@elizaos/plugin-openai": "2.0.3-beta.7",
    "@elizaos/plugin-pdf": "2.0.3-beta.7",
    "@elizaos/plugin-discord": "2.0.3-beta.7",
    "@elizaos/plugin-signal": "2.0.3-beta.7",
    "@elizaos/plugin-slack": "2.0.3-beta.7",
    "@elizaos/plugin-remote-manifest": "workspace:*",
    "@elizaos/plugin-sql": "2.0.3-beta.7",
    "@elizaos/plugin-telegram": "2.0.3-beta.7",
    "@elizaos/plugin-whatsapp": "2.0.3-beta.7",
    "@elizaos/plugin-worker-runtime": "workspace:*",
    "@doolittle/provider-transport": "workspace:*",
    "@elizaos/registry": "workspace:*",
    "@elizaos/shared": "2.0.3-beta.7",
    "@elizaos/skills": "2.0.3-beta.7",
    "@elizaos/vault": "2.0.3-beta.7",
    "@fal-ai/client": "^1.9.4",
    "dotenv": "^17.2.3",
    "shell-quote": "1.10.0",
    "elizaos": "2.0.3-beta.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@elizaos/agent": "2.0.3-beta.7",
    "@elizaos/app-core": "2.0.3-beta.7",
    "@elizaos/core": "2.0.3-beta.7",
    "@elizaos/logger": "2.0.3-beta.7",
    "@elizaos/plugin-agent-orchestrator": "2.0.3-beta.7",
    "@elizaos/plugin-agent-skills": "2.0.3-beta.7",
    "@elizaos/plugin-codex-cli": "2.0.3-beta.7",
    "@elizaos/plugin-mcp": "2.0.3-beta.7",
    "@elizaos/plugin-form": "2.0.3-beta.7",
    "@elizaos/plugin-github": "2.0.3-beta.7",
    "@elizaos/skills": "2.0.3-beta.7",
    "@elizaos/plugin-anthropic": "2.0.3-beta.7",
    "@elizaos/plugin-browser": "2.0.3-beta.7",
    "@elizaos/plugin-elizacloud": "2.0.3-beta.7",
    "@elizaos/plugin-ollama": "2.0.3-beta.7",
    "@elizaos/plugin-openai": "2.0.3-beta.7",
    "@elizaos/plugin-pdf": "2.0.3-beta.7",
    "@elizaos/plugin-discord": "2.0.3-beta.7",
    "@elizaos/plugin-signal": "2.0.3-beta.7",
    "@elizaos/plugin-slack": "2.0.3-beta.7",
    "@elizaos/plugin-sql": "2.0.3-beta.7",
    "@elizaos/plugin-remote-manifest": "workspace:*",
    "@elizaos/plugin-telegram": "2.0.3-beta.7",
    "@elizaos/plugin-whatsapp": "2.0.3-beta.7",
    "@elizaos/plugin-wechat": "2.0.3-beta.7",
    "@elizaos/shared": "2.0.3-beta.7",
    "@elizaos/ui": "2.0.3-beta.7",
    "@elizaos/vault": "2.0.3-beta.7",
    "elizaos": "2.0.3-beta.7",
    "ollama-ai-provider": "npm:ollama-ai-provider-v2@^3.5.1",
    "protobufjs": "7.6.5",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@nubjs/nub": "0.6.0",
    "@playwright/test": "^1.58.2",
    "@types/blessed": "^0.1.27",
    "@types/node": "^26.1.1",
    "blessed": "^0.1.81",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "allowBuilds": {
    "@nubjs/nub": true,
    "esbuild": true,
    "sharp": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "packageManager": "nub@0.6.0"
}
