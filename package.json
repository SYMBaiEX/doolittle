{
  "name": "doolittle",
  "version": "0.1.0",
  "private": true,
  "elizaSdk": {
    "channel": "beta",
    "version": "2.0.3-beta.7",
    "packageVersions": {
      "@elizaos/logger": "2.0.11-beta.7",
      "@elizaos/plugin-agent-skills": "2.0.11-beta.7",
      "@elizaos/plugin-mcp": "2.0.11-beta.7",
      "@elizaos/skills": "2.0.11-beta.7",
      "@elizaos/plugin-browser": "2.0.11-beta.7",
      "@elizaos/plugin-elizacloud": "2.0.11-beta.7",
      "@elizaos/plugin-pdf": "2.0.11-beta.7",
      "@elizaos/vault": "2.0.11-beta.7",
      "@elizaos/contracts": "2.0.11-beta.7",
      "@elizaos/plugin-aosp-local-inference": "2.0.11-beta.7",
      "@elizaos/plugin-app-manager": "2.0.11-beta.7",
      "@elizaos/plugin-registry": "2.0.11-beta.7",
      "@elizaos/plugin-streaming": "2.0.11-beta.7",
      "@elizaos/prompts": "2.0.11-beta.7",
      "@elizaos/security": "2.0.11-beta.7",
      "@elizaos/tui": "2.0.11-beta.7"
    }
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "doolittle": "./apps/cli/src/index.ts"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "description": "Nub monorepo for Doolittle desktop, terminal chat, shared ElizaOS runtime and tools.",
  "workspaces": [
    "apps/desktop",
    "apps/cli",
    "packages/acp",
    "packages/agent",
    "packages/contracts",
    "packages/ui",
    "packages/evals",
    "packages/plugin-remote-manifest",
    "packages/plugin-worker-runtime",
    "packages/registry",
    "packages/skill-packs-optional",
    "packages/plugins",
    "packages/plugins/*",
    "packages/skills",
    "packages/characters"
  ],
  "scripts": {
    "bootstrap": "nub scripts/bootstrap.ts",
    "bootstrap:check": "nub scripts/bootstrap.ts --check",
    "onboard": "nub scripts/bootstrap.ts",
    "smoke:linked-providers": "nub scripts/smoke-linked-providers.ts",
    "publish:providers": "nub scripts/publish-provider-packages.ts",
    "publish:providers:alpha": "nub run publish:providers -- --provider all --publish --tag alpha",
    "install:deps": "bash scripts/install.sh",
    "sandbox:setup": "bash scripts/sandbox-setup.sh",
    "dev": "nub run --cwd apps/cli dev",
    "start": "nub run --cwd apps/cli start",
    "build": "nub run --recursive --if-present build",
    "native:status": "nub apps/cli/src/index.ts native status",
    "native:coverage": "nub apps/cli/src/index.ts native coverage",
    "native:build": "nub apps/cli/src/index.ts native build",
    "native:test": "nub run native:build && nub scripts/test-native-probe.ts",
    "native:verify": "nub run native:coverage && nub run native:test",
    "desktop:dev": "nub run --cwd apps/desktop dev",
    "desktop:build": "nub run --cwd apps/desktop build",
    "desktop:typecheck": "nub run --cwd apps/desktop typecheck",
    "desktop:test": "nub run --cwd apps/desktop test",
    "desktop:runtime:install": "node node_modules/electron/install.js",
    "desktop:runtime:prepare": "nub run --cwd apps/desktop runtime:prepare",
    "desktop:runtime:audit": "nub run --cwd apps/desktop runtime:audit",
    "desktop:package": "nub run --cwd apps/desktop package",
    "desktop:package:dir": "nub run --cwd apps/desktop package:dir",
    "desktop:install:mac": "nub run --cwd apps/desktop install:mac -- --allow-ad-hoc",
    "desktop:package:mac": "nub run --cwd apps/desktop package:mac",
    "desktop:package:win": "nub run --cwd apps/desktop package:win",
    "desktop:package:linux": "nub run --cwd apps/desktop package:linux",
    "desktop:package:all": "nub run --cwd apps/desktop package:all",
    "test:e2e:desktop-packaged": "nub scripts/run-desktop-packaged-tests.ts",
    "test:e2e:desktop-workbench": "nub run cli:build && nub run desktop:build && nubx playwright test --config playwright.workbench.config.ts",
    "lint": "nubx biome check --write .",
    "lint:check": "nubx biome check .",
    "knip:deps": "nubx knip --config knip.json --dependencies --no-progress --no-config-hints --no-tag-hints",
    "audit:production:critical": "nub scripts/audit-production.ts critical",
    "audit:production:high": "nub scripts/audit-production.ts high",
    "typecheck": "nub run typecheck:tools && nub run --recursive --if-present typecheck",
    "ui:typecheck": "nub run --cwd packages/ui typecheck",
    "ui:test": "nub run --cwd packages/ui test",
    "test": "nubx vitest run --config vitest.config.ts",
    "test:essential": "nub run test",
    "test:release": "nub run test",
    "test:scope": "nub scripts/vitest-scope.ts run",
    "test:related": "nub scripts/vitest-scope.ts related",
    "test:changed": "nubx vitest run --changed",
    "test:watch": "nubx vitest watch --config vitest.config.ts",
    "test:watch:scope": "nub scripts/vitest-scope.ts watch",
    "test:all": "nub run test && nub run test:e2e",
    "test:integration": "nub run cli:build && DOOLITTLE_RUN_RUNTIME_E2E=1 nubx vitest run --config vitest.integration.config.ts",
    "test:integration:workers": "nub run test:integration",
    "eval:list": "nub packages/evals/src/coding/list-cli.ts",
    "eval:coding": "nub packages/evals/src/coding/cli.ts",
    "eval:headless": "nub packages/evals/src/headless/cli.ts",
    "eval:headless:compare": "nub packages/evals/src/headless/compare-cli.ts",
    "eval:headless:aggregate": "nub packages/evals/src/headless/aggregate-cli.ts",
    "eval:compare": "nub packages/evals/src/coding/compare-cli.ts",
    "eval:reports": "nub packages/evals/src/coding/reports-cli.ts",
    "eval:review": "nub packages/evals/src/review/cli.ts",
    "check:alpha": "nub run check:release",
    "test:e2e": "nub run test:integration && nub run test:e2e:desktop-workbench",
    "test:e2e:release:source": "nub run test:integration",
    "test:e2e:release:workbench-core": "nub run test:e2e:desktop-workbench",
    "test:e2e:release:packaged-core": "DOOLITTLE_DESKTOP_EXECUTABLE= nub scripts/run-desktop-packaged-tests.ts",
    "test:e2e:release": "nub run test:e2e && nub run desktop:package:dir && DOOLITTLE_DESKTOP_EXECUTABLE= nub run test:e2e:desktop-packaged",
    "check:repo-hygiene": "nub scripts/check-repo-hygiene.ts",
    "check:workflow-security": "nub scripts/check-workflow-security.ts",
    "check:plugin-boundaries": "nub scripts/check-plugin-boundaries.ts",
    "check:eliza-sdk": "nub scripts/check-eliza-sdk-release.ts",
    "check:runtime-advisory-policy": "nub scripts/check-runtime-advisory-policy.ts",
    "check:docs-truth": "nub scripts/sync-doc-truth.ts --check",
    "check:local-links": "nub scripts/check-local-links.ts",
    "check:acceptance": "nub run check:monorepo && nub run check:repo-hygiene && nub run check:workflow-security && nub run check:plugin-boundaries && nub run check:eliza-sdk && nub run check:docs-truth && nub run check:local-links && nub run knip:deps && nub run audit:production:critical",
    "check": "nub run test",
    "check:all": "nub run check:release",
    "check:release:static": "nub run lint:check && nub run typecheck && nub run test:release && nub run build && nub run check:acceptance && nub run check:runtime-advisory-policy && nub run desktop:runtime:prepare && nub run desktop:runtime:audit",
    "check:release": "nub run check:release:static && nub run test:e2e:release",
    "publish:claude-code:dry-run": "nub run publish:providers -- --provider claude-code",
    "publish:devin:dry-run": "nub run publish:providers -- --provider devin",
    "publish:provider-transport:dry-run": "nub run publish:providers -- --provider provider-transport",
    "publish:providers:check": "nub run publish:providers -- --provider all",
    "workspace:list": "nub scripts/workspaces.ts",
    "workspace:plugins": "nub run --cwd apps/cli start --help",
    "cli:dev": "nub run --cwd apps/cli dev",
    "cli:build": "nub run --cwd apps/cli build",
    "cli:typecheck": "nub run --cwd apps/cli typecheck",
    "typecheck:tools": "nubx tsc --noEmit",
    "check:monorepo": "nub scripts/check-monorepo.ts"
  },
