+        try {
+            await handle.writeFile(serialize(value, o), "utf-8");
+        }
+        finally {
+            await handle.close();
+        }
         await fsp.rename(tmp, filePath);
     }
     finally {
-        await fsp.rm(tmp, { force: true }).catch(() => { });
