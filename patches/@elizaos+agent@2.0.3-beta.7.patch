+    return `${filePath}.tmp-${process.pid}-${randomUUID()}`;
 }
@@ -43,15 +44,21 @@ export async function writeJsonAtomic(filePath, value, opts) {
     }
     const tmp = tmpPathFor(filePath);
+    let owned = false;
     try {
-        await fsp.writeFile(tmp, serialize(value, o), {
-            encoding: "utf-8",
-            mode: o.mode,
-        });
+        const handle = await fsp.open(tmp, "wx", o.mode);
