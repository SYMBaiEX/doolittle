{
  "name": "@doolittle/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Primary Doolittle application package.",
  "dependencies": {
    "@doolittle/acp": "workspace:*",
    "@doolittle/contracts": "workspace:*",
    "@doolittle/logger": "workspace:*",
    "@elizaos/agent": "2.0.3-beta.7",
    "@elizaos/skills": "2.0.3-beta.7"
  },
  "scripts": {
    "dev": "nub watch src/index.ts",
    "start": "nub src/index.ts",
    "build": "nubx --node esbuild ./src/index.ts --bundle --platform=node --format=esm --target=node26 --outdir=../../dist --external:sharp --external:term.js --external:pty.js --external:@elizaos/*"
  }
}
