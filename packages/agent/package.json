    "@doolittle/plugin-claude-code": "workspace:*",
    "@doolittle/plugin-codex": "workspace:*",
    "@doolittle/plugin-devin": "workspace:*",
    "@doolittle/plugin-sql-compat": "workspace:*",
    "@elizaos/plugin-elizacloud": "2.0.3-beta.7",
    "@elizaos/plugin-ollama": "2.0.3-beta.7",
