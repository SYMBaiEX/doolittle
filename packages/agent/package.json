  "scripts": {
    "dev": "nub watch src/index.ts",
    "start": "nub src/index.ts",
    "build": "nubx --node esbuild ./src/index.ts ./src/acp-server.ts --bundle --platform=node --format=esm --target=node26 --outdir=../../dist --external:sharp --external:term.js --external:pty.js --external:@elizaos/* --banner:js='import { createRequire as __doolittleCreateRequire } from \"node:module\";const require = __doolittleCreateRequire(import.meta.url);'"
  }
